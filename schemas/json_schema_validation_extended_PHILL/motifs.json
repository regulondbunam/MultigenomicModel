{
  "motifs": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": ["_id", "products_id", "organisms_id"],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "alternateSequence": {
            "type": "string"
          },
          "attachedGroup": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "dataSource": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "externalCrossReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["externalCrossReferences_id", "objectId"],
              "properties": {
                "externalCrossReferences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "objectId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "homologyMotif": {
            "type": "string"
          },
          "internalComment": {
            "type": "string"
          },
          "leftEndPosition": {
            "type": "number",
            "multipleOf": 1.0
          },
          "note": {
            "type": "string"
          },
          "organisms_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "products_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "rightEndPosition": {
            "type": "number",
            "multipleOf": 1.0
          },
          "sequence": {
            "type": "string"
          },
          "residueNumber": {
            "type": "array",
            "items": {
              "type": "number",
              "multipleOf": 1.0
            }
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
}
