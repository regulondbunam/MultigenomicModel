{
	"terminators": {
		"validator": {
			"$jsonSchema": {
				"type": "object",
				"required": [
					"_id",
					"transcriptionTerminationSite",
					"sequence",
					"class",
					"organisms_id"
				],
				"properties": {
					"_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"class": {
						"type": "string",
						"enum": [
							"rho-independent",
							"rho-dependent"
						]
					},
					"citations": {
								"type": "array",
								"uniqueItems": true,
								"items": {
									"type": "object",
									"anyOf": [{
										"required": ["publications_id"]
									}, {
										"required": ["evidences_id"]
									}],
									"properties": {
										"publications_id": {
											"type": "string",
											"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
										},
										"evidences_id": {
											"type": "string",
											"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
										}
									},
									"additionalProperties": false
								}
							},
					"externalCrossReferences": {
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "object",
							"required": [
								"externalCrossReferences_id",
								"objectId"
							],
							"properties": {
								"externalCrossReferences_id": {
									"type": "string",
									"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
								},
								"objectId": {
									"type": "string"
								}
							},
							"additionalProperties": false
						}
					},
					"internalComment": {
						"type": "string"
					},
					"note": {
						"type": "string"
					},
					"organisms_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"sequence": {
						"type": "string",
						"pattern": "^[ATCGatcg]+$"
					},
					"transcriptionTerminationSite": {
						"type": "object",
						"required": ["leftEndPosition", "rightEndPosition"],
						"properties": {
							"leftEndPosition": {
								"type": "number",
								"multipleOf": 1.0
							},
							"rightEndPosition": {
								"type": "number",
								"multipleOf": 1.0
							},
							"type": {
								"type": "string",
								"enum": ["primary", "secondary", "tertiary"]
							}
						},
						"additionalProperties": false
					},
					"schemaVersion": {
						"type": "number"
					}
				},
				"additionalProperties": false
			}
		},
		"validationLevel": "strict",
		"validationAction": "error"
	}
}