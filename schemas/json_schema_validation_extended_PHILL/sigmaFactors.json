{
	"sigmaFactors": {
		"validator": {
			"$jsonSchema": {
				"type": "object",
				"required": [
					"_id",
					"name",
					"genes_id",
					"organisms_id"
				],
				"properties": {
					"_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"citations": {
								"type": "array",
								"uniqueItems": true,
								"items": {
									"type": "object",
									"anyOf": [{
										"required": ["publications_id"]
									}, {
										"required": ["evidences_id"]
									}],
									"properties": {
										"publications_id": {
											"type": "string",
											"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
										},
										"evidences_id": {
											"type": "string",
											"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
										}
									},
									"additionalProperties": false
								}
							},
					"externalCrossReferences": {
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "object",
							"required": [
								"externalCrossReferences_id",
								"objectId"
							],
							"properties": {
								"externalCrossReferences_id": {
									"type": "string",
									"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
								},
								"objectId": {
									"type": "string"
								}
							},
							"additionalProperties": false
						}
					},
					"genes_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"internalComment": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"note": {
						"type": "string"
					},
					"organisms_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"synonyms": {
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "string"
						}
					},
					"schemaVersion": {
						"type": "number"
					}
				},
				"additionalProperties": false
			}
		},
		"validationLevel": "strict",
		"validationAction": "error"
	}
}