{
  "segments": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "type"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "absoluteCenterPosition": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "publications_id"
                  ]
                },
                {
                  "required": [
                    "evidences_id"
                  ]
                }
              ],
              "properties": {
                "publications_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "evidences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                }
              },
              "additionalProperties": false
            }
          },
          "confidenceLevel": {
            "type": "string"
          },
          "externalCrossReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "externalCrossReferences_id",
                "objectId"
              ],
              "properties": {
                "externalCrossReferences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "objectId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "name": {
            "type": "string"
          },
          "leftEndPosition": {
            "type": "number",
            "multipleOf": 1.0
          },
          "rightEndPosition": {
            "type": "number",
            "multipleOf": 1.0
          },
          "parentClass": {
            "type": "string"
          },
          "strand": {
            "type": "string",
            "enum": [
              "forward",
              "reverse"
            ]
          },
          "type": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
}