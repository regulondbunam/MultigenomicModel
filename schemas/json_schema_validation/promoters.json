{
  "promoters": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": ["_id", "organisms_id"],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "bindsSigmaFactor": {
            "type": "object",
            "properties": {
              "citations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "anyOf": [
                    {
                      "required": ["publications_id"]
                    },
                    {
                      "required": ["evidences_id"]
                    }
                  ],
                  "properties": {
                    "publications_id": {
                      "type": "string",
                      "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                    },
                    "evidences_id": {
                      "type": "string",
                      "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "sigmaFactors_id": {
                "type": "string",
                "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
              }
            },
            "additionalProperties": false
          },
          "boxes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "leftEndPosition",
                "rightEndPosition",
                "sequence",
                "type"
              ],
              "properties": {
                "leftEndPosition": {
                  "type": "number",
                  "multipleOf": 1.0
                },
                "rightEndPosition": {
                  "type": "number",
                  "multipleOf": 1.0
                },
                "sequence": {
                  "type": "string",
                  "pattern": "^[ATCGatcg]+$"
                },
                "type": {
                  "type": "string",
                  "enum": ["minus10", "minus35", "minus12", "minus24"]
                }
              },
              "additionalProperties": false
            }
          },
          "distanceToGene": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": ["publications_id"]
                },
                {
                  "required": ["evidences_id"]
                }
              ],
              "properties": {
                "publications_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "evidences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                }
              },
              "additionalProperties": false
            }
          },
          "externalCrossReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["externalCrossReferences_id", "objectId"],
              "properties": {
                "externalCrossReferences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "objectId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "internalComment": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "organisms_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "pos1": {
            "type": "number",
            "multipleOf": 1.0
          },
          "score": {
            "type": "number"
          },
          "sequence": {
            "type": "string",
            "pattern": "^[ATCGatcg]+$"
          },
          "strand": {
            "type": "string",
            "enum": ["forward", "reverse"]
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "transcriptionStartSite": {
            "type": "object",
            "required": ["leftEndPosition", "rightEndPosition", "range"],
            "properties": {
              "leftEndPosition": {
                "type": "number",
                "multipleOf": 1.0
              },
              "rightEndPosition": {
                "type": "number",
                "multipleOf": 1.0
              },
              "range": {
                "type": "number",
                "multipleOf": 1.0
              },
              "type": {
                "type": "string",
                "enum": ["primary", "secondary", "tertiary"]
              }
            },
            "additionalProperties": false
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
}
