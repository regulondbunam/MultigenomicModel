{
  "regulatoryInteractions": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": ["_id", "organisms_id"],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "accessoryProteins": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
            }
          },
          "absoluteCenterPosition": {
            "type": "number"
          },
          "citations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": ["publications_id"]
                },
                {
                  "required": ["evidences_id"]
                }
              ],
              "properties": {
                "publications_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "evidences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                }
              },
              "additionalProperties": false
            }
          },
          "externalCrossReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["externalCrossReferences_id", "objectId"],
              "properties": {
                "externalCrossReferences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "objectId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "function": {
            "type": "string",
            "enum": ["activator", "repressor", "dual"]
          },
          "internalComment": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "mechanism": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regulationType": {
            "type": "string"
          },
          "organisms_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "regulatedEntity": {
            "type": "object",
            "required": ["_id", "type"],
            "properties": {
              "_id": {
                "type": "string",
                "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["gene", "srna", "promoter", "transcriptionUnit"]
              }
            }
          },
          "regulator": {
            "type": "object",
            "required": ["_id", "type"],
            "properties": {
              "_id": {
                "type": "string",
                "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["regulatoryComplex", "regulatoryContinuant", "product"]
              }
            },
            "additionalProperties": false
          },
          "sequence": {
            "type": "string",
            "pattern": "^[ATCGatcg]+$"
          },
          "regulatorySites_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "type": {
            "type": "string",
            "enum": ["mechanistic", "physiological"]
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
}
