{
  "regulatoryComplexes": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": ["_id", "organisms_id"],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "abbreviatedName": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": ["publications_id"]
                },
                {
                  "required": ["evidences_id"]
                }
              ],
              "properties": {
                "publications_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "evidences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                }
              },
              "additionalProperties": false
            }
          },
          "externalCrossReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["externalCrossReferences_id", "objectId"],
              "properties": {
                "externalCrossReferences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "objectId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "function": {
            "type": "string"
          },
          "internalComment": {
            "type": "string"
          },
          "isTranscriptionFactor": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "organisms_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "products": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "products_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "coefficient": {
                  "type": "number",
                  "multipleOf": 1.0
                }
              },
              "additionalProperties": false
            }
          },
          "regulatoryContinuants_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
            }
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": ["active", "inactive"]
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
}
