{
	"shineDalgarnos": {
		"validator": {
			"$jsonSchema": {
				"type": "object",
				"required": [
					"_id",
					"distanceToGene",
					"genes_id",
					"organisms_id"
				],
				"properties": {
					"_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"distanceToGene": {
						"type": "number",
						"multipleOf": 1.0
					},
					"genes_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"internalComment": {
						"type": "string"
					},
					"leftEndPosition": {
						"type": "number",
						"multipleOf": 1.0
					},
					"note": {
						"type": "string"
					},
					"organisms_id": {
						"type": "string",
						"pattern": "^RDB[A-Z]{8}[0-9]{5}$"
					},
					"rightEndPosition": {
						"type": "number",
						"multipleOf": 1.0
					},
					"sequence": {
						"type": "string"
					},
					"schemaVersion": {
						"type": "number"
					}
				},
				"additionalProperties": false
			}
		},
		"validationLevel": "strict",
		"validationAction": "error"
	}
}