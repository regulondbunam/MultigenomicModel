{
  "regulators": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "type"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "abbreviatedName": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "publications_id"
                  ]
                },
                {
                  "required": [
                    "evidences_id"
                  ]
                }
              ],
              "properties": {
                "publications_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "evidences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                }
              },
              "additionalProperties": false
            }
          },
          "confidenceLevel": {
            "type": "string"
          },
          "externalCrossReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "externalCrossReferences_id",
                "objectId"
              ],
              "properties": {
                "externalCrossReferences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "objectId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "name": {
            "type": "string"
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "small RNA",
              "transcriptionFactor",
              "regulatoryContinuant"
            ]
          },
          "regulatorClass": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "regulationType": {
              "type": "string"
            },
          "note": {
            "type": "string"
          },
          "conformations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "class": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
      "validationLevel": "strict",
      "validationAction": "error"
  }
}