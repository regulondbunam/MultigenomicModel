{
  "transcriptionFactors": {
    "validator": {
      "$jsonSchema": {
        "type": "object",
        "required": [
          "_id",
          "organisms_id"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "activeConformations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "product",
                    "regulatoryComplex"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "citations": {
            "type": "array",
            "uniqueItems": false,
            "items": {
              "type": "object",
              "anyOf": [
                {
                  "required": [
                    "publications_id"
                  ]
                },
                {
                  "required": [
                    "evidences_id"
                  ]
                }
              ],
              "properties": {
                "publications_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "evidences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                }
              },
              "additionalProperties": false
            }
          },
          "confidenceLevel": {
            "type": "string"
          },
          "connectivityClass": {
            "type": "string"
          },
          "externalCrossReferences": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": [
                "externalCrossReferences_id",
                "objectId"
              ],
              "properties": {
                "externalCrossReferences_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "objectId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "globalFunction": {
            "type": "string",
            "enum": [
              "activator",
              "repressor",
              "dual"
            ]
          },
          "inactiveConformations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "product",
                    "regulatoryComplex"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "name": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "organisms_id": {
            "type": "string",
            "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
          },
          "products_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^RDB[A-Z]{8}[0-9]{5}$"
            }
          },
          "sensingClass": {
            "type": "string"
          },
          "siteLength": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "synonyms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "validationLevel": "strict",
    "validationAction": "error"
  }
}